<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Trạng thái CHECKED (đang được chọn): nền tím indigo -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/chip_bg_selected" />
        </shape>
    </item>

    <!-- Trạng thái mặc định (không được chọn): nền xám nhạt -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="@color/chip_bg_default" />
        </shape>
    </item>

</selector>