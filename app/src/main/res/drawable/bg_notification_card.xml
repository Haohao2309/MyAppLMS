<?xml version="1.0" encoding="utf-8"?>

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Bo góc 12dp — gọn gàng, không quá tròn -->
    <corners android:radius="12dp" />

    <!-- Nền trắng thuần cho trạng thái đã đọc -->
    <solid android:color="@color/notification_read_background" />

    <!-- Viền xám nhạt để tạo ranh giới nhẹ với nền gray_50 -->
    <stroke
        android:width="1dp"
        android:color="@color/notification_read_stroke" />

</shape>