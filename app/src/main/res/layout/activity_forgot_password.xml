<?xml version="1.0" encoding="utf-8"?>
<!-- =====================================================================
     activity_forgot_password.xml  — 3 bước trong 1 layout, dùng
     ViewFlipper để chuyển bước: Step1 → Step2 (OTP) → Step3 (New Pwd)
     ===================================================================== -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:fillViewport="true"
    tools:context=".ui.auth.ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="32dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- Logo -->

        <!-- Step Progress Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Step 1 dot -->
            <View
                android:id="@+id/dot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_indigo" />

            <View
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:background="@color/input_border"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <!-- Step 2 dot -->
            <View
                android:id="@+id/dot2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_indigo"
                android:backgroundTint="@color/gray_400"/>

            <View
                android:layout_width="32dp"
                android:layout_height="2dp"
                android:background="@color/input_border"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <!-- Step 3 dot -->
            <View
                android:id="@+id/dot3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/bg_dot_indigo"
                android:backgroundTint="@color/gray_400"/>

        </LinearLayout>

        <!-- Step label -->
        <TextView
            android:id="@+id/tvStepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Step 1 of 3"
            android:textSize="12sp"
            android:textColor="@color/text_grey" />

        <!-- ViewFlipper: contains 3 cards for 3 steps -->
        <ViewFlipper
            android:id="@+id/viewFlipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:inAnimation="@android:anim/slide_in_left"
            android:outAnimation="@android:anim/slide_out_right">

            <!-- ════════════════════════════════════════════
                 STEP 1 — Enter Email
                 ════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/ic_email"
                        android:background="@drawable/bg_dot_indigo"
                        android:backgroundTint="@color/background_tab_light"
                        android:padding="14dp"
                        app:tint="@color/purple_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Forgot Password?"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Enter your registered email address and we'll send you a verification code."
                        android:textSize="13sp"
                        android:textColor="@color/text_grey"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp" />

                    <!-- Email input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Email Address"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_email"
                            app:tint="@color/text_grey" />

                        <EditText
                            android:id="@+id/etForgotEmail"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="Enter your email"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_hint"
                            android:inputType="textEmailAddress"
                            android:background="@android:color/transparent"
                            android:maxLines="1"
                            android:imeOptions="actionDone" />
                    </LinearLayout>

                    <!-- Send Code Button -->
                    <Button
                        android:id="@+id/btnSendCode"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="24dp"
                        android:text="Send Verification Code"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_button" />

                    <!-- Back to Login -->
                    <TextView
                        android:id="@+id/tvBackToLogin1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Back to Sign In"
                        android:textSize="14sp"
                        android:textColor="@color/purple_primary"
                        android:gravity="center" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ════════════════════════════════════════════
                 STEP 2 — Enter OTP Code
                 ════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/ic_otp_shield"
                        android:background="@drawable/bg_dot_indigo"
                        android:backgroundTint="@color/background_tab_light"
                        android:padding="14dp"
                        app:tint="@color/purple_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Check Your Email"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvOtpSentTo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="We sent a 6-digit code to\nyour@email.com"
                        android:textSize="13sp"
                        android:textColor="@color/text_grey"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp" />

                    <!-- OTP 6 boxes -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:weightSum="6">

                        <EditText android:id="@+id/otp1"
                            style="@style/OtpBox" android:layout_weight="1" />
                        <EditText android:id="@+id/otp2"
                            style="@style/OtpBox" android:layout_weight="1" />
                        <EditText android:id="@+id/otp3"
                            style="@style/OtpBox" android:layout_weight="1" />
                        <EditText android:id="@+id/otp4"
                            style="@style/OtpBox" android:layout_weight="1" />
                        <EditText android:id="@+id/otp5"
                            style="@style/OtpBox" android:layout_weight="1" />
                        <EditText android:id="@+id/otp6"
                            style="@style/OtpBox" android:layout_weight="1" />

                    </LinearLayout>

                    <!-- Timer -->
                    <TextView
                        android:id="@+id/tvTimer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Code expires in 05:00"
                        android:textSize="13sp"
                        android:textColor="@color/purple_primary"
                        android:gravity="center" />

                    <!-- Verify Button -->
                    <Button
                        android:id="@+id/btnVerifyOtp"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="24dp"
                        android:text="Verify Code"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_button" />

                    <!-- Resend -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Didn't receive it? "
                            android:textSize="13sp"
                            android:textColor="@color/text_grey" />

                        <TextView
                            android:id="@+id/tvResendCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resend"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/purple_primary" />
                    </LinearLayout>

                    <!-- Back -->
                    <TextView
                        android:id="@+id/tvBackStep1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Change Email"
                        android:textSize="14sp"
                        android:textColor="@color/text_grey"
                        android:gravity="center" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ════════════════════════════════════════════
                 STEP 3 — Reset Password
                 ════════════════════════════════════════════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Icon -->
                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center_horizontal"
                        android:src="@drawable/ic_lock"
                        android:background="@drawable/bg_dot_indigo"
                        android:backgroundTint="@color/background_tab_light"
                        android:padding="14dp"
                        app:tint="@color/purple_primary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Reset Password"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_dark"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Create a strong new password for your account."
                        android:textSize="13sp"
                        android:textColor="@color/text_grey"
                        android:gravity="center" />

                    <!-- New Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="New Password"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/text_grey" />

                        <EditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="Enter new password"
                            android:inputType="textPassword"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_hint"
                            android:background="@android:color/transparent"
                            android:maxLines="1" />

                        <ImageView
                            android:id="@+id/ivToggleNewPwd"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_eye"
                            app:tint="@color/text_grey"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Password Strength Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:weightSum="4">

                        <View android:id="@+id/strengthBar1"
                            android:layout_width="0dp" android:layout_height="4dp"
                            android:layout_weight="1" android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_strength_empty"
                            android:radius="2dp" />
                        <View android:id="@+id/strengthBar2"
                            android:layout_width="0dp" android:layout_height="4dp"
                            android:layout_weight="1" android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_strength_empty" />
                        <View android:id="@+id/strengthBar3"
                            android:layout_width="0dp" android:layout_height="4dp"
                            android:layout_weight="1" android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_strength_empty" />
                        <View android:id="@+id/strengthBar4"
                            android:layout_width="0dp" android:layout_height="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_strength_empty" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStrengthLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Password strength: —"
                        android:textSize="12sp"
                        android:textColor="@color/text_grey" />

                    <!-- Confirm New Password -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Confirm New Password"
                        android:textSize="14sp"
                        android:textColor="@color/text_dark" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/text_grey" />

                        <EditText
                            android:id="@+id/etConfirmNewPassword"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:hint="Re-enter new password"
                            android:inputType="textPassword"
                            android:textSize="14sp"
                            android:textColor="@color/text_dark"
                            android:textColorHint="@color/text_hint"
                            android:background="@android:color/transparent"
                            android:maxLines="1"
                            android:imeOptions="actionDone" />

                        <ImageView
                            android:id="@+id/ivToggleConfirmPwd"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_eye"
                            app:tint="@color/text_grey"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Reset Button -->
                    <Button
                        android:id="@+id/btnResetPassword"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="24dp"
                        android:text="Reset Password"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_button"
                        />

                    <!-- Back -->
                    <TextView
                        android:id="@+id/tvBackStep2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Back"
                        android:textSize="14sp"
                        android:textColor="@color/text_grey"
                        android:gravity="center" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </ViewFlipper>

    </LinearLayout>
</ScrollView>