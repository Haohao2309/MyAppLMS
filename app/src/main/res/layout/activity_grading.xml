<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/gray_50">

    <!-- ── HEADER ─────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chấm điểm · Bài 1/3"
                android:textColor="@color/gray_500"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/tv_grading_student_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nguyễn Minh Anh"
                android:textColor="@color/gray_900"
                android:textSize="17sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Điểm hiện tại (cập nhật live) -->
        <TextView
            android:id="@+id/tv_current_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/100"
            android:textColor="@color/gray_400"
            android:textSize="14sp"
            android:layout_marginStart="2dp"/>
    </LinearLayout>

    <!-- ── SCROLL CONTENT ─────────────────────────────────── -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── SECTION 01: BÀI NỘP ──────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="01"
                            android:textColor="@color/primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_section_number"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Bài nộp"
                            android:textColor="@color/gray_900"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Row: icon file + tên + thời gian + nút xem -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_file_row"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="@color/primary"
                            android:layout_marginEnd="10dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bài làm của học sinh"
                                android:textColor="@color/gray_900"
                                android:textSize="14sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tv_grading_submit_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 giờ trước"
                                android:textColor="@color/gray_500"
                                android:textSize="12sp"/>
                        </LinearLayout>

                        <com.google.android.material.chip.Chip
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đúng hạn"
                            android:textSize="11sp"
                            app:chipBackgroundColor="@color/success_light"
                            android:textColor="@color/success"
                            style="@style/Widget.MaterialComponents.Chip.Entry"/>
                    </LinearLayout>

                    <!-- Nút xem file Drive -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_file"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:text="Xem bài trên Drive"
                        android:textSize="14sp"
                        app:cornerRadius="22dp"
                        app:icon="@android:drawable/ic_media_play"
                        app:iconGravity="textStart"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECTION 02: NHẬP ĐIỂM ─────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="02"
                            android:textColor="@color/indigo_600"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_section_number_indigo"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Nhập điểm"
                            android:textColor="@color/gray_900"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Tiêu chí 1: Nội dung & Lập luận -->
                    <include layout="@layout/item_score_criteria"
                        android:id="@+id/criteria_content"/>

                    <!-- Hiển thị label thủ công vì include không truyền được text -->
                    <!-- Sử dụng LinearLayout thay thế cho mỗi tiêu chí -->

                    <!-- Nội dung & Lập luận -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Nội dung &amp; Lập luận"
                                    android:textColor="@color/gray_800"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Chất lượng và độ sâu của lập luận"
                                    android:textColor="@color/gray_500"
                                    android:textSize="12sp"/>
                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_score_content"
                                android:layout_width="56dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:hint="0"
                                android:inputType="number"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary"
                                android:background="@drawable/bg_score_input"/>

                            <TextView
                                android:id="@+id/tv_content_max"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="/25"
                                android:textColor="@color/gray_400"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="0"
                            android:max="25"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:progressTint="@color/primary"
                            android:progressBackgroundTint="@color/gray_200"/>
                    </LinearLayout>

                    <!-- Cấu trúc & Tổ chức -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cấu trúc &amp; Tổ chức"
                                    android:textColor="@color/gray_800"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Bố cục rõ ràng, mạch lạc"
                                    android:textColor="@color/gray_500"
                                    android:textSize="12sp"/>
                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_score_structure"
                                android:layout_width="56dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:hint="0"
                                android:inputType="number"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/success"
                                android:background="@drawable/bg_score_input"/>

                            <TextView
                                android:id="@+id/tv_structure_max"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="/25"
                                android:textColor="@color/gray_400"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="0"
                            android:max="25"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:progressTint="@color/success"
                            android:progressBackgroundTint="@color/gray_200"/>
                    </LinearLayout>

                    <!-- Ngôn ngữ & Văn phong -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ngôn ngữ &amp; Văn phong"
                                    android:textColor="@color/gray_800"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Từ vựng, ngữ pháp và phong cách"
                                    android:textColor="@color/gray_500"
                                    android:textSize="12sp"/>
                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_score_language"
                                android:layout_width="56dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:hint="0"
                                android:inputType="number"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/warning"
                                android:background="@drawable/bg_score_input"/>

                            <TextView
                                android:id="@+id/tv_language_max"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="/25"
                                android:textColor="@color/gray_400"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="0"
                            android:max="25"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:progressTint="@color/warning"
                            android:progressBackgroundTint="@color/gray_200"/>
                    </LinearLayout>

                    <!-- Tư duy Phản biện -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tư duy Phản biện"
                                    android:textColor="@color/gray_800"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Khả năng phân tích, đánh giá"
                                    android:textColor="@color/gray_500"
                                    android:textSize="12sp"/>
                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_score_critical"
                                android:layout_width="56dp"
                                android:layout_height="44dp"
                                android:gravity="center"
                                android:hint="0"
                                android:inputType="number"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/indigo_600"
                                android:background="@drawable/bg_score_input"/>

                            <TextView
                                android:id="@+id/tv_critical_max"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="/25"
                                android:textColor="@color/gray_400"
                                android:textSize="14sp"/>
                        </LinearLayout>

                        <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:progress="0"
                            android:max="25"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:progressTint="@color/indigo_600"
                            android:progressBackgroundTint="@color/gray_200"/>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- Tổng điểm -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Tổng điểm"
                            android:textColor="@color/gray_900"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tv_total_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/primary"
                            android:textSize="28sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/100"
                            android:textColor="@color/gray_400"
                            android:textSize="16sp"
                            android:layout_marginStart="2dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── SECTION 03: NHẬN XÉT ─────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:text="03"
                            android:textColor="@color/gray_600"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:background="@drawable/bg_section_number_gray"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Nhận xét"
                            android:textColor="@color/gray_900"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Tags chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_feedback"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        app:chipSpacingHorizontal="6dp"
                        app:chipSpacingVertical="4dp"/>

                    <!-- Ô nhận xét -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusTopStart="12dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <EditText
                            android:id="@+id/et_feedback_comment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Nhận xét chi tiết cho học sinh..."
                            android:minLines="3"
                            android:maxLines="6"
                            android:gravity="top|start"
                            android:textSize="14sp"
                            android:textColor="@color/gray_800"
                            android:inputType="textMultiLine"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── NÚT GHI NHẬN ĐIỂM (fixed bottom) ─────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_grade"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ghi nhận điểm"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_menu_edit"
            app:iconGravity="textStart"
            app:backgroundTint="@color/indigo_600"/>

    </LinearLayout>

</LinearLayout>