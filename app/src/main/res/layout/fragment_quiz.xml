<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <LinearLayout
            android:id="@+id/layout_quiz_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="@dimen/elevation_card"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_large">

                    <TextView
                        android:id="@+id/tv_quiz_title"
                        style="@style/TextHeading3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/title_quiz"
                        android:layout_marginBottom="@dimen/spacing_medium"/>

                    <LinearLayout
                        android:id="@+id/layout_questions_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btn_submit_quiz"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xlarge"
                android:text="@string/action_submit"
                app:cornerRadius="@dimen/corner_radius_medium"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_quiz_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="60dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/success_green"
                android:layout_marginBottom="@dimen/spacing_medium"/>

            <TextView
                style="@style/TextHeading3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuyệt vời!"
                android:textColor="@color/success_green"
                android:layout_marginBottom="@dimen/spacing_tiny"/>

            <TextView
                style="@style/TextBody1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn đã hoàn thành bài kiểm tra này"
                android:layout_marginBottom="@dimen/spacing_large"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_radius_large"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/background_light"
                android:layout_marginBottom="@dimen/spacing_large">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="24dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextBody2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ĐIỂM SỐ CỦA BẠN"
                        android:textStyle="bold"
                        android:textColor="@color/primary"/>

                    <TextView
                        android:id="@+id/tv_result_score"
                        style="@style/TextDisplay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 / 10"
                        android:textColor="@color/primary_dark"
                        android:layout_marginTop="8dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btn_retake_quiz"
                style="@style/ButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Làm lại bài thi"
                android:backgroundTint="@color/surface"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp"
                app:cornerRadius="@dimen/corner_radius_medium"/>
        </LinearLayout>

    </FrameLayout>
</ScrollView>