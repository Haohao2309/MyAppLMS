<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_module_container">

    <!-- Header: Avatar + Name & Date + Rating -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Avatar hình tròn chứa chữ cái đầu -->
        <TextView
            android:id="@+id/tv_reviewer_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="15sp"
            android:text="U"
            android:background="@drawable/bg_avatar_circle" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Tên người dùng -->
            <TextView
                android:id="@+id/tv_reviewer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên học viên"
                android:textStyle="bold"
                android:textColor="@color/course_text_title"
                android:textSize="14sp" />

            <!-- Ngày đánh giá -->
            <TextView
                android:id="@+id/tv_review_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="20-10-2023"
                android:textSize="11sp"
                android:textColor="@color/course_text_muted" />
        </LinearLayout>

        <!-- Hàng sao đánh giá -->
        <TextView
            android:id="@+id/tv_review_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★★★★★"
            android:textColor="#FFB300"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tiêu đề review -->
    <TextView
        android:id="@+id/tv_review_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tiêu đề đánh giá"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/course_text_title" />

    <!-- Nội dung review -->
    <TextView
        android:id="@+id/tv_review_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Nội dung đánh giá khóa học chi tiết của học viên."
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/course_text_body" />

    <!-- Pros: Danh sách điểm tốt -->
    <LinearLayout
        android:id="@+id/layout_pros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Cons: Danh sách điểm cần cải thiện -->
    <LinearLayout
        android:id="@+id/layout_cons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- Nút Vote: Upvote + Downvote -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="start">

        <TextView
            android:id="@+id/tv_review_upvotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="👍 0"
            android:textSize="12sp"
            android:textColor="@color/course_text_body"
            android:background="@drawable/bg_upvote_chip" />

        <TextView
            android:id="@+id/tv_review_downvotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="👎 0"
            android:textSize="12sp"
            android:textColor="@color/course_text_body"
            android:background="@drawable/bg_upvote_chip" />

    </LinearLayout>

</LinearLayout>

