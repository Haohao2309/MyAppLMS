<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_medium">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/corner_radius_large"
            app:cardElevation="@dimen/elevation_card"
            app:cardBackgroundColor="@color/surface"
            android:layout_marginBottom="@dimen/spacing_large">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <TextView
                    style="@style/TextHeading3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_assignment"
                    android:layout_marginBottom="@dimen/spacing_large"/>

                <TextView
                    style="@style/TextBody1"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_drive_link"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <EditText
                    android:id="@+id/et_drive_link"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:hint="@string/hint_drive_link"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:inputType="textUri"
                    android:paddingHorizontal="@dimen/spacing_medium"
                    android:textSize="@dimen/text_size_body"
                    android:background="@drawable/bg_edittext_rounded"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <TextView
                    style="@style/TextCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desc_drive_link"
                    android:layout_marginBottom="@dimen/spacing_large"/>

                <TextView
                    style="@style/TextBody1"
                    android:textStyle="bold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_student_notes"
                    android:layout_marginBottom="@dimen/spacing_small"/>

                <EditText
                    android:id="@+id/et_student_notes"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:hint="@string/hint_student_notes"
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:padding="@dimen/spacing_medium"
                    android:textSize="@dimen/text_size_body"
                    android:background="@drawable/bg_edittext_rounded"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btn_submit_assignment"
            style="@style/ButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_submit"
            app:cornerRadius="@dimen/corner_radius_medium"/>
    </LinearLayout>
</ScrollView>