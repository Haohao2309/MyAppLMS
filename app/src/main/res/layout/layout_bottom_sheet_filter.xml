<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet" android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Level"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rgLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbLevelAll" android:text="All Levels" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/rbLevelBeginner" android:text="Beginner" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/rbLevelIntermediate" android:text="Intermediate" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/rbLevelAdvanced" android:text="Advanced" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rgPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RadioButton android:id="@+id/rbPriceAll" android:text="All" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/rbPriceFree" android:text="Free" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/rbPriceUnder50" android:text="Under $50" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/rbPrice50to100" android:text="$50-$100" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <RadioButton android:id="@+id/rbPriceOver100" android:text="Over $100" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            </RadioGroup>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Minimum Rating"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/cgRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip android:id="@+id/chipRatingAny" android:text="Any" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Chip.Choice"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipRating4" android:text="★ 5" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Chip.Choice"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipRating3" android:text="★ 4+" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Chip.Choice"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipRating2" android:text="★ 3+" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Chip.Choice"/>
        <com.google.android.material.chip.Chip android:id="@+id/chipRating1" android:text="★ 2+" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.MaterialComponents.Chip.Choice"/>

    </com.google.android.material.chip.ChipGroup>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp">
        <TextView
            android:id="@+id/tvClearFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear Filters"
            android:textColor="@android:color/holo_red_dark"
            android:layout_centerVertical="true"/>

        <Button
            android:id="@+id/btnApplyFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>