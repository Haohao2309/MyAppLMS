<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thumbnail Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/ivFeaturedThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_background"
                android:contentDescription="@null" />

            <!-- Duration badge -->
            <TextView
                android:id="@+id/tvFeaturedDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_search_bar"
                android:backgroundTint="#CC000000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="0h 0m"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- Info Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Tags: Category + Level -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFeaturedCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_unselected"
                    android:backgroundTint="#EDE7F6"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Category"
                    android:textColor="#5E35B1"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvFeaturedLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:backgroundTint="#E8F5E9"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Beginner"
                    android:textColor="#4CAF50"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tvFeaturedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Course Title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Instructor -->
            <TextView
                android:id="@+id/tvFeaturedInstructor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="by Instructor"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- Stats: Rating · Students · Lessons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_star_filled"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvFeaturedRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="0.0"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Students -->
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_profile"
                    android:contentDescription="@null"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvFeaturedStudents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="0 students"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <!-- Lessons -->
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_lessons"
                    android:contentDescription="@null"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvFeaturedLessons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="0 lessons"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
